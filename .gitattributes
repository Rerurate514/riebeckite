# Normalize every text file to LF in the repository and in every checkout,
# regardless of the local `core.autocrlf` setting. Biome enforces LF, so a
# CRLF working tree makes `pnpm check` fail on Windows.
* text=auto eol=lf

# Keep the external content fixtures byte-stable across platforms. The E2E
# asserts exact attachment sizes, so line-ending conversion must not apply.
tests/external-site/fixture/vault/** -text

# The scaffold golden fixtures freeze generated bytes. Image and PDF payloads
# must never pass through line-ending conversion, even if `text=auto` guesses
# that they are text.
packages/integrations/honox/test/__golden__/scaffold/**/*.ico -text
packages/integrations/honox/test/__golden__/scaffold/**/*.png -text
packages/integrations/honox/test/__golden__/scaffold/**/project-brief.pdf -text
