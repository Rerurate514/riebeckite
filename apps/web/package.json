    "@riebeckite/plugin-lightbox": "workspace:*",
    "@riebeckite/plugin-local-graph": "workspace:*",
    "@riebeckite/plugin-media": "workspace:*",
    "@riebeckite/plugin-mermaid": "workspace:*",
    "@riebeckite/plugin-recent-posts": "workspace:*",
    "@riebeckite/plugin-search": "workspace:*",
    "@riebeckite/plugin-seo": "workspace:*",
    "@riebeckite/plugin-toc": "workspace:*",
    "@riebeckite/theme-default": "workspace:*",
