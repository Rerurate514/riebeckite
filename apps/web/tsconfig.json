{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"],
    "types": ["vite/client", "@cloudflare/workers-types/2023-07-01"],
    "baseUrl": "../..",
    "paths": {
      "@riebeckite/core": ["packages/core/index.ts"],
      "@riebeckite/plugin-autocardlink": [
        "packages/plugin-autocardlink/index.ts"
      ],
      "@riebeckite/plugin-diagnostics": [
        "packages/plugin-diagnostics/index.ts"
      ],
      "@riebeckite/plugin-lightbox": ["packages/plugin-lightbox/index.ts"],
      "@riebeckite/plugin-seo": ["packages/plugin-seo/index.ts"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
