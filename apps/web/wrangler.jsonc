{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riebeckite",
  "compatibility_date": "2026-06-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/worker.js",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "riebeckite.dev",
      "custom_domain": true
    }
  ]
}
