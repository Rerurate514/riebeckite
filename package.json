{
  "name": "riebeckite-monorepo",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @riebeckite/web dev",
    "build": "pnpm build:packages && pnpm --filter @riebeckite/web build",
    "build:packages": "node scripts/build_packages.mjs",
    "bump:version": "node scripts/bump_version.mjs",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:packages": "node scripts/check_packages.mjs",
    "check:dependencies": "node scripts/check_dependencies.mjs",
    "check:templates": "node scripts/check_deploy_template.mjs",
    "check:scaffold": "node scripts/check_scaffold.mjs",
    "check:docs": "node scripts/check_docs.mjs && node scripts/check_plugin_docs_parity.mjs && node scripts/sync_theme_docs.mjs --check",
    "check:plugin-docs": "node scripts/sync_plugin_docs.mjs --check",
    "check:theme-docs": "node scripts/sync_theme_docs.mjs --check",
    "docs:sync": "node scripts/sync_plugin_docs.mjs && node scripts/sync_theme_docs.mjs",
    "typecheck": "node scripts/typecheck_packages.mjs",
    "release": "node scripts/release.mjs",
    "test": "pnpm -r test",
    "test:docs": "node --test scripts/sync_plugin_docs.test.mjs scripts/check_plugin_docs_parity.test.mjs scripts/sync_theme_docs.test.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "test:registry": "node scripts/run_registry_e2e.mjs",
    "test:update": "node scripts/run_tests.mjs --update",
    "test:e2e:external": "node --import tsx tests/external-site/run.ts",
    "test:plugin-dx": "pnpm --dir tests/plugin-dx run test",
    "test:plugin-dx:external": "pnpm --dir tests/plugin-dx run test:external",
    "benchmark:vault": "node --import tsx --expose-gc benchmarks/core.mjs",
    "benchmark:equivalence": "node --import tsx benchmarks/equivalence.mjs",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@riebeckite/cli": "workspace:*",
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^24.5.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.22.4",
    "typescript": "^5.0.0"
  }
}
