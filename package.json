{
  "name": "riebeckite-monorepo",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @riebeckite/web predev && pnpm --filter @riebeckite/web dev",
    "build": "pnpm --filter @riebeckite/cli build && pnpm --filter @riebeckite/web build",
    "build:packages": "pnpm -r --filter \"./packages/**\" run build",
    "bump:version": "node scripts/bump_version.mjs",
    "check:packages": "node scripts/check_packages.mjs",
    "check:dependencies": "node scripts/check_dependencies.mjs",
    "check:templates": "node scripts/check_deploy_template.mjs",
    "check:scaffold": "node scripts/check_scaffold.mjs",
    "check:docs": "node scripts/check_docs.mjs",
    "typecheck": "node scripts/typecheck_packages.mjs",
    "release": "node scripts/release.mjs",
    "test:e2e:external": "node tests/external-site/run.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@riebeckite/cli": "workspace:*",
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^24.5.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0"
  }
}
