{
  "name": "@riebeckite/cli",
  "version": "0.0.19",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "riebeckite": "./bin/riebeckite.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README_ja.md",
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --minify --main-fields=module,main --banner:js=\"import{createRequire as __createRequire}from'node:module';const require=__createRequire(import.meta.url);\" --external:esbuild --external:vite --external:create-riebeckite --alias:@riebeckite/core=../core/index.ts --alias:@riebeckite/honox=../integrations/honox/index.ts --outfile=dist/cli.js",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "prepack": "node ../../scripts/copy_license.mjs && pnpm run build"
  },
  "dependencies": {
    "@riebeckite/core": "workspace:*",
    "@riebeckite/honox": "workspace:*",
    "create-riebeckite": "workspace:*",
    "esbuild": "catalog:",
    "jsonc-parser": "^3.3.1",
    "vite": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  },
  "description": "Command-line tooling for building and validating Riebeckite sites.",
  "keywords": [
    "riebeckite",
    "cli",
    "markdown",
    "static-site-generator"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false
}
