{
  "name": "@riebeckite/cli",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "riebeckite": "./bin/riebeckite.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=cjs --minify --external:esbuild --external:vite --alias:@riebeckite/core=../core/index.ts --alias:@riebeckite/honox=../integrations/honox/index.ts --outfile=dist/cli.cjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@riebeckite/honox": "workspace:*",
    "esbuild": "^0.28.2",
    "vite": "^8.0.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  }
}
