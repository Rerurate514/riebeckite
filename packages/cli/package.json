{
  "name": "@riebeckite/cli",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "riebeckite": "./bin/riebeckite.mjs"
  },
  "files": [
    "LICENSE",
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --minify --banner:js=\"import{createRequire as __createRequire}from'node:module';const require=__createRequire(import.meta.url);\" --external:esbuild --external:vite --alias:@riebeckite/core=../core/index.ts --alias:@riebeckite/honox=../integrations/honox/index.ts --outfile=dist/cli.js",
    "prepack": "node ../../scripts/copy_license.mjs && pnpm run build"
  },
  "dependencies": {
    "@riebeckite/core": "workspace:*",
    "@riebeckite/honox": "workspace:*",
    "esbuild": "catalog:",
    "vite": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  }
}
