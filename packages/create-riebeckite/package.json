{
  "name": "create-riebeckite",
  "version": "0.0.14",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "create-riebeckite": "./bin/create-riebeckite.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "source": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "README_ja.md",
    "bin",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@riebeckite/honox": "workspace:*"
  },
  "scripts": {
    "build": "node ../../scripts/build_package.mjs",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/create-riebeckite"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  },
  "description": "Create a new Riebeckite site from the official starter template.",
  "keywords": [
    "create-riebeckite",
    "riebeckite",
    "scaffold",
    "static-site-generator"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false
}
