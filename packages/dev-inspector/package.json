{
  "name": "@riebeckite/dev-inspector",
  "version": "0.0.46",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@riebeckite/core": "workspace:*",
    "@riebeckite/diagnostics": "workspace:*",
    "@riebeckite/node": "workspace:*",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@riebeckite/test": "workspace:*",
    "tsx": "^4.22.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "BRIDGE.md",
    "BRIDGE_ja.md",
    "README.md",
    "README_ja.md",
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build_package.mjs",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/dev-inspector"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  },
  "description": "Development inspector overlay for Riebeckite sites.",
  "keywords": [
    "riebeckite",
    "vite",
    "inspector",
    "development"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
