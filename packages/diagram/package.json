{
  "name": "@riebeckite/diagram",
  "version": "0.0.35",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "source": "./client.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README_ja.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@riebeckite/core": "workspace:*"
  },
  "devDependencies": {
    "@riebeckite/test": "workspace:*",
    "tsx": "^4.22.4"
  },
  "scripts": {
    "build": "node ../../scripts/build_package.mjs",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/diagram"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  },
  "description": "Shared diagram infrastructure for Riebeckite plugins.",
  "keywords": [
    "riebeckite",
    "diagram",
    "plugin"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false
}
