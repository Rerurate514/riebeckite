{
  "name": "@riebeckite/honox",
  "version": "0.0.14",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./index.ts",
      "default": "./dist/index.js"
    },
    "./scaffold": {
      "types": "./dist/src/scaffold/presets.d.ts",
      "import": "./dist/src/scaffold/presets.js",
      "source": "./src/scaffold/presets.ts",
      "default": "./dist/src/scaffold/presets.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "source": "./server.ts",
      "default": "./dist/server.js"
    },
    "./ui": {
      "types": "./dist/src/ui/primitives.d.ts",
      "import": "./dist/src/ui/primitives.js",
      "source": "./src/ui/primitives.tsx",
      "default": "./dist/src/ui/primitives.js"
    }
  },
  "dependencies": {
    "@babel/parser": "^7.29.3",
    "@riebeckite/core": "workspace:*",
    "esbuild": "catalog:",
    "hono": "catalog:",
    "vite": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README_ja.md",
    "assets",
    "dist"
  ],
  "scripts": {
    "build": "node ../../../scripts/build_package.mjs",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/integrations/honox"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  },
  "description": "HonoX and Vite integration for building Riebeckite sites.",
  "keywords": [
    "riebeckite",
    "honox",
    "vite",
    "static-site-generator"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false
}
