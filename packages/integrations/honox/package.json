{
  "name": "@riebeckite/honox",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "source": "./server.ts",
      "default": "./dist/server.js"
    },
    "./ui": {
      "types": "./dist/src/ui/primitives.d.ts",
      "import": "./dist/src/ui/primitives.js",
      "source": "./src/ui/primitives.tsx",
      "default": "./dist/src/ui/primitives.js"
    }
  },
  "dependencies": {
    "@riebeckite/core": "workspace:*",
    "esbuild": "^0.28.2",
    "hono": "^4.12.25",
    "vite": "^8.0.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../../scripts/build_package.mjs",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/integrations/honox"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  }
}
