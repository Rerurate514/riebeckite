{
  "name": "@riebeckite/honox",
  "version": "0.0.38",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "source": "./server.ts",
      "default": "./dist/server.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "source": "./runtime.ts",
      "default": "./dist/runtime.js"
    },
    "./ui": {
      "types": "./dist/src/ui/primitives.d.ts",
      "import": "./dist/src/ui/primitives.js",
      "source": "./src/ui/primitives.tsx",
      "default": "./dist/src/ui/primitives.js"
    },
    "./ui/context": {
      "types": "./dist/src/ui/context.d.ts",
      "import": "./dist/src/ui/context.js",
      "source": "./src/ui/context.ts",
      "default": "./dist/src/ui/context.js"
    },
    "./style.css": "./style.css"
  },
  "dependencies": {
    "@babel/parser": "^7.29.3",
    "@riebeckite/core": "workspace:*",
    "@riebeckite/dev-inspector": "workspace:*",
    "@riebeckite/node": "workspace:*",
    "@riebeckite/plugin-color-mode": "workspace:*",
    "@riebeckite/spa": "workspace:*",
    "@riebeckite/ui": "workspace:*",
    "esbuild": "catalog:",
    "hono": "catalog:",
    "honox": "0.1.62",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@d2lang/d2": "^0.1.34",
    "@marp-team/marp-core": "^4.4.0",
    "@riebeckite/test": "workspace:*",
    "tsx": "^4.22.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README_ja.md",
    "dist",
    "style.css"
  ],
  "scripts": {
    "build": "node ../../../scripts/build_package.mjs",
    "test": "node --max-old-space-size=4096 --import tsx --test --test-concurrency=1 \"test/*.test.ts\"",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/integrations/honox"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  },
  "description": "HonoX and Vite integration for building Riebeckite sites.",
  "keywords": [
    "riebeckite",
    "honox",
    "vite",
    "static-site-generator"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": [
    "./style.css"
  ]
}
