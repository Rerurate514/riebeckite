{
  "name": "@riebeckite/mcp",
  "version": "0.3.2",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "riebeckite-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "README_ja.md",
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "node ../../scripts/build_package.mjs",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  },
  "description": "MCP server for a local Riebeckite development Bridge.",
  "keywords": [
    "riebeckite",
    "mcp",
    "model-context-protocol",
    "development"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  }
