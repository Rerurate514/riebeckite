{
  "name": "@riebeckite/plugin-diagnostics",
  "version": "0.0.19",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./index.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "riebeckite-diagnostics": "./dist/bin.js"
  },
  "dependencies": {
    "@riebeckite/core": "workspace:*",
    "remark-parse": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:"
  },
  "devDependencies": {
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "tsx": "^4.22.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README_ja.md",
    "dist"
  ],
  "scripts": {
    "build": "node ../../../scripts/build_package.mjs",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/plugins/diagnostics"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  },
  "description": "Content diagnostics for Riebeckite and Obsidian vaults.",
  "keywords": [
    "riebeckite",
    "plugin",
    "diagnostics",
    "obsidian"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false
}
