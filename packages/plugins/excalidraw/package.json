{
  "name": "@riebeckite/plugin-excalidraw",
  "version": "0.0.10",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "source": "./client.ts",
      "default": "./dist/client.js"
    },
    "./style.css": "./style.css"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@riebeckite/core": "workspace:*",
    "lz-string": "^1.5.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/mdast": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README_ja.md",
    "dist",
    "style.css"
  ],
  "scripts": {
    "build": "node ../../../scripts/build_package.mjs",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/plugins/excalidraw"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  },
  "description": "Excalidraw attachment rendering for Obsidian wikilinks.",
  "keywords": [
    "riebeckite",
    "plugin",
    "excalidraw",
    "obsidian"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
