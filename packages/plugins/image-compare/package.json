{
  "name": "@riebeckite/plugin-image-compare",
  "version": "0.3.2",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "source": "./client.ts",
      "default": "./dist/client.js"
    },
    "./style.css": "./style.css"
  },
  "dependencies": {
    "@riebeckite/ui": "workspace:*",
    "@types/mdast": "catalog:",
    "unist-util-visit": "catalog:"
  },
  "peerDependencies": {
    "@riebeckite/core": "workspace:^"
  },
  "devDependencies": {
    "@riebeckite/core": "workspace:*",
    "tsx": "^4.22.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README_ja.md",
    "dist",
    "style.css"
  ],
  "scripts": {
    "build": "node ../../../scripts/build_package.mjs",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/plugins/image-compare"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  },
  "description": "Before/after image comparison sliders for Riebeckite code blocks.",
  "keywords": [
    "riebeckite",
    "plugin",
    "image",
    "comparison",
    "slider"
