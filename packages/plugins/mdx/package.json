{
  "name": "@riebeckite/plugin-mdx",
  "version": "0.0.46",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@riebeckite/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README_ja.md",
    "dist"
  ],
  "scripts": {
    "build": "node ../../../scripts/build_package.mjs",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/plugins/mdx"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  },
  "description": "Trusted MDX content support for Riebeckite.",
  "keywords": [
    "riebeckite",
    "plugin",
    "mdx",
    "jsx"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false
}
