{
  "name": "@riebeckite/plugin-obsidian-markdown",
  "version": "0.0.8",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@riebeckite/core": "workspace:*",
    "@types/mdast": "catalog:",
    "@types/unist": "catalog:",
    "github-slugger": "^2.0.0",
    "slugify": "^1.6.9",
    "unist-util-visit": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README_ja.md",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../../scripts/build_package.mjs",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/plugins/obsidian-markdown"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  },
  "description": "Obsidian-flavored Markdown support for Riebeckite.",
  "keywords": [
    "riebeckite",
    "plugin",
    "obsidian",
    "markdown"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false
}
