{
  "name": "@riebeckite/plugin-vega-lite",
  "version": "0.0.18",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "source": "./client.ts",
      "default": "./dist/client.js"
    },
    "./style.css": "./style.css"
  },
  "dependencies": {
    "@riebeckite/core": "workspace:*",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.4.3"
