{
  "name": "@riebeckite/preview",
  "version": "0.0.31",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./index.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "source": "./ui.ts",
      "default": "./dist/ui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README_ja.md",
    "dist"
  ],
  "dependencies": {
    "@riebeckite/core": "workspace:*",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@riebeckite/plugin-code-tabs": "workspace:*",
    "@riebeckite/plugin-obsidian-markdown": "workspace:*",
    "tsx": "^4.22.4"
  },
  "scripts": {
    "build": "node ../../scripts/build_package.mjs",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/preview"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  },
  "description": "Shared secure Markdown preview runtime for Riebeckite.",
  "keywords": [
    "riebeckite",
    "preview",
    "markdown"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false
}
