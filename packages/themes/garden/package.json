{
  "name": "@riebeckite/theme-garden",
  "version": "0.0.32",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "source": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./style.css": "./styles/theme.css",
    "./styles/theme.css": "./styles/theme.css"
  },
  "dependencies": {
    "@riebeckite/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README_ja.md",
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "node ../../../scripts/build_package.mjs",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/themes/garden"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  },
  "description": "A digital-garden CSS theme for Riebeckite sites.",
  "keywords": [
    "riebeckite",
    "theme",
    "css",
    "digital-garden"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": [
    "./styles/*.css"
  ]
}
