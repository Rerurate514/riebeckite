{
  "name": "@riebeckite/ui",
  "version": "0.0.35",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  },
  "description": "Optional headless UI primitives, accessibility behaviors, and shared context for Riebeckite.",
  "keywords": [
    "riebeckite",
    "ui",
    "headless",
    "accessibility",
    "drawer",
    "tabs",
    "context",
    "hono",
    "jsx"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./index.tsx",
      "default": "./dist/index.js"
    },
    "./drawer": {
      "types": "./dist/drawer.d.ts",
      "import": "./dist/drawer.js",
      "source": "./drawer.tsx",
      "default": "./dist/drawer.js"
    },
    "./drawer/client": {
      "types": "./dist/drawer-client.d.ts",
      "import": "./dist/drawer-client.js",
      "source": "./drawer-client.ts",
      "default": "./dist/drawer-client.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "import": "./dist/dialog.js",
      "source": "./dialog.ts",
      "default": "./dist/dialog.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js",
      "source": "./tabs.ts",
      "default": "./dist/tabs.js"
    },
    "./copy": {
      "types": "./dist/copy.d.ts",
      "import": "./dist/copy.js",
      "source": "./copy.ts",
      "default": "./dist/copy.js"
    },
    "./behaviors": {
      "types": "./dist/behaviors.d.ts",
      "import": "./dist/behaviors.js",
      "source": "./behaviors.ts",
      "default": "./dist/behaviors.js"
    },
    "./styles/drawer.css": "./styles/drawer.css"
  },
  "dependencies": {
    "@riebeckite/core": "workspace:*",
    "hono": "catalog:"
  },
  "scripts": {
    "build": "node ../../scripts/build_package.mjs",
    "test": "node --import tsx --test \"test/*.test.ts*\"",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README_ja.md",
    "dist",
    "styles"
  ],
  "sideEffects": [
    "./drawer-client.ts",
    "./src/drawer/client.ts",
    "./dist/drawer-client.js",
    "./styles/drawer.css"
  ]
}
