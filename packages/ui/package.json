{
  "name": "@riebeckite/ui",
  "version": "0.0.35",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rerurate514/riebeckite.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/Rerurate514/riebeckite#readme",
  "bugs": {
    "url": "https://github.com/Rerurate514/riebeckite/issues"
  },
  "description": "Shared declarative UI context for Riebeckite integrations and plugins.",
  "keywords": [
    "riebeckite",
    "ui",
    "context",
    "hono",
    "jsx"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./index.tsx",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@riebeckite/core": "workspace:*",
    "hono": "catalog:"
  },
  "scripts": {
    "build": "node ../../scripts/build_package.mjs",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README_ja.md",
    "dist"
  ],
  "sideEffects": false
}
