{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@riebeckite/core": ["packages/core/index.ts"],
      "@riebeckite/core/cli": ["packages/core/cli.ts"],
      "@riebeckite/core/client": ["packages/core/client.ts"],
      "@riebeckite/graph": ["packages/graph/index.ts"],
      "@riebeckite/graph/client": ["packages/graph/client.ts"],
      "@riebeckite/graph/ui": ["packages/graph/ui.tsx"],
      "@riebeckite/diagram": ["packages/diagram/index.ts"],
      "@riebeckite/diagram/client": ["packages/diagram/client.ts"],
      "@riebeckite/node": ["packages/node/index.ts"],
      "@riebeckite/diagnostics": ["packages/diagnostics/index.ts"],
      "@riebeckite/preview": ["packages/preview/index.ts"],
      "@riebeckite/honox": ["packages/integrations/honox/index.ts"],
      "@riebeckite/honox/server": ["packages/integrations/honox/server.ts"],
      "@riebeckite/honox/runtime": ["packages/integrations/honox/runtime.ts"],
      "@riebeckite/dev-inspector": ["packages/dev-inspector/index.ts"],
      "@riebeckite/honox/ui": [
        "packages/integrations/honox/src/ui/primitives.tsx"
      ],
      "@riebeckite/ui": ["packages/ui/index.tsx"],
      "@riebeckite/ui/drawer": ["packages/ui/drawer.tsx"],
      "@riebeckite/ui/drawer/client": ["packages/ui/drawer-client.ts"],
      "@riebeckite/ui/dialog": ["packages/ui/dialog.ts"],
      "@riebeckite/ui/tabs": ["packages/ui/tabs.ts"],
      "@riebeckite/ui/copy": ["packages/ui/copy.ts"],
      "@riebeckite/ui/behaviors": ["packages/ui/behaviors.ts"],
      "@riebeckite/ui/loading": ["packages/ui/loading.ts"],
      "create-riebeckite": ["packages/create-riebeckite/src/index.ts"],
      "create-riebeckite/scaffold": [
        "packages/create-riebeckite/src/scaffold/index.ts"
      ],
      "@riebeckite/test/e2e": ["packages/test/e2e/index.ts"],
      "@riebeckite/test": ["packages/test/index.ts"],
      "@riebeckite/test/fixtures": ["packages/test/fixtures.ts"],
      "@riebeckite/plugin-*": ["packages/plugins/*/index.ts"],
      "@riebeckite/plugin-*/client": ["packages/plugins/*/client.ts"],
      "@riebeckite/theme-*": ["packages/themes/*/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx"],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/templates",
    "**/__golden__",
    "**/.riebeckite/**",
    "packages/*/test/**",
    "packages/*/*/test/**",
    "packages/test/e2e/**"
  ]
}
